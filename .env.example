# Supabase credentials for the BFF (server/). Copy this file to .env and fill in your project's values
# (Supabase dashboard → Project Settings → API Keys). On Render, set the same variables in the service's
# Environment settings instead of using a file.
#
# These are SERVER-ONLY. They have no VITE_ prefix on purpose: Vite never puts them in the browser bundle,
# and the browser only ever calls /api on our own server. Keep the existing working project configuration.
# Marketplace uses a verified user session, so it does not require a privileged replacement key.
# If using a secret/service_role key, it bypasses Row Level Security; never expose it in src/.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Required on deployed services: exact public Office Floor origin (HTTPS in production).
# Not a dashboard URL; never derive this from untrusted Host / forwarded headers.
# Local defaults allow http://localhost:5173 and :4173 (also 127.0.0.1).
# APP_ORIGIN=https://office.example.com
#
# Optional server-only public project key for isolated auth and Marketplace clients.
# If omitted, they use SEPARATE clients with the existing key, never sign into the shared BFF client.
# SUPABASE_PUBLISHABLE_KEY=your-publishable-project-key

# Jira Earn Coins (optional, all server-only). See .skills/jira-rewards/SKILL.md for full setup.
# Without these, the Earn Coins panel shows a setup message and no Jira calls are made.
# Root URL of your Jira Cloud site (no path).
# JIRA_SITE_URL=https://your-site.atlassian.net
# Atlassian OAuth 2.0 (3LO) app; scopes: read:jira-work read:jira-user offline_access
# JIRA_OAUTH_CLIENT_ID=your-atlassian-client-id
# JIRA_OAUTH_CLIENT_SECRET=your-atlassian-client-secret
# Must equal APP_ORIGIN + /api/jira/callback and match the Atlassian app's callback URL.
# Locally, set APP_ORIGIN to the same origin (the Jira default is http://localhost:5173).
# JIRA_OAUTH_CALLBACK_URL=http://localhost:4173/api/jira/callback
# 64 hex characters: openssl rand -hex 32. Signs worker calls and encrypts stored OAuth tokens.
# JIRA_REWARD_SIGNING_SECRET=
# AI complexity analysis and the background worker.
# JIRA_AI_ENABLED=true
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=your-model-name
